package components

templ InputArea() {
	<div class="relative">
		<div
			class="absolute left-[50%] top-[50%] w-min -translate-x-1/2 -translate-y-1/2"
			data-loading="block"
		>
			@Spinner()
		</div>
		<textarea
			id="input-area"
			class="h-fit w-full brutal bg-white p-4 outline-none"
			name="note"
			data-loading-class="opacity-30"
			data-loading-disable
			data-loading-aria-busy
			oninput="debouncedSaveLocalStorate(this.value)"
		></textarea>
	</div>
}
