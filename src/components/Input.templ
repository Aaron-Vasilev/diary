package components

templ Input(route, inputType, target, placeholder string) {
	<input
		class="min-h-7 w-full brutal bg-transparent p-2 text-xl outline-none"
		name="search"
		placeholder={ placeholder }
		type={ inputType }
		hx-post={ Url(route) }
		hx-trigger="input change delay:500ms, search"
		hx-target={ target }
	/>
}
